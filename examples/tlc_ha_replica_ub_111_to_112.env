# HA Replica UB data-channel deployment for the 111/112 test machines.
# Values may be overridden by exporting the same variable before running the
# benchmark script. UB access mode is selected by the shared open fallback.

HA_REMOTE_DIR="${HA_REMOTE_DIR:-/root/szz/codespace/hpc-redis}"
HA_NODE111_SSH="${HA_NODE111_SSH:-root@43.154.145.18}"
HA_NODE112_SSH="${HA_NODE112_SSH:-root@43.154.145.18}"
HA_NODE111_PORT="${HA_NODE111_PORT:-8111}"
HA_NODE112_PORT="${HA_NODE112_PORT:-8112}"

# 真实机映射规则（本地 Export -> 对端 Import）：
#   111: 1->5, 2->6, 3->7, 4->8, 9->13, 10->14, 11->15, 12->16
#   112: 1->5, 2->6, 3->7, 4->8, 9->13, 10->14, 11->15, 12->16
# HA Replica 选用两条双向 ring：111 export 4 -> 112 import 8，
# 以及 112 export 9 -> 111 import 13。
# 同机 CLI 不能复用上述 Replica path：CLI@111 可用本地 dev1/2/3 或远端
# Import dev14/11/16；CLI@112 可用本地 dev1/2/3 或远端 Import dev7/2/5。
TLC_HA_NODE111_TX_PATH="${TLC_HA_NODE111_TX_PATH:-/dev/obmm_shmdev4}"
TLC_HA_NODE111_RX_PATH="${TLC_HA_NODE111_RX_PATH:-/dev/obmm_shmdev13}"
TLC_HA_NODE112_TX_PATH="${TLC_HA_NODE112_TX_PATH:-/dev/obmm_shmdev9}"
TLC_HA_NODE112_RX_PATH="${TLC_HA_NODE112_RX_PATH:-/dev/obmm_shmdev8}"

# 111 TX and 112 RX share this region; 112 TX and 111 RX share the other.
TLC_HA_UB_TX_OFFSET="${TLC_HA_UB_TX_OFFSET:-134217728}"
TLC_HA_UB_RX_OFFSET="${TLC_HA_UB_RX_OFFSET:-201326592}"

# Persistent test COLD directories. Leave unset to use a unique /tmp path per run.
# TLC_HA_NODE111_COLD_DIR=/tmp/tlc-ha-ub-node111
# TLC_HA_NODE112_COLD_DIR=/tmp/tlc-ha-ub-node112
# TLC_HA_REPLAY_START=1
# TLC_HA_REPLAY_END=10000

# HA TCP control plane. Follower listens on CONTROL_PORT; Leader connects to
# PEER_HOST:CONTROL_PORT. Internal IPs reachable between 111 and 112.
TLC_HA_NODE111_HOST="${TLC_HA_NODE111_HOST:-192.168.90.111}"
TLC_HA_NODE112_HOST="${TLC_HA_NODE112_HOST:-192.168.90.112}"
TLC_HA_UB_CONTROL_PORT="${TLC_HA_UB_CONTROL_PORT:-9736}"
# Each node binds its own advertised address; the peer connects internally.
TLC_HA_UB_NODE111_BIND_HOST="${TLC_HA_UB_NODE111_BIND_HOST:-$TLC_HA_NODE111_HOST}"
TLC_HA_UB_NODE112_BIND_HOST="${TLC_HA_UB_NODE112_BIND_HOST:-$TLC_HA_NODE112_HOST}"

TLC_HA_FOLLOWER_LOG="${TLC_HA_FOLLOWER_LOG:-/tmp/tlc_ha_ub_follower.log}"
TLC_HA_LEADER_LOG="${TLC_HA_LEADER_LOG:-/tmp/tlc_ha_ub_leader.log}"
TLC_HA_TEST_TIMEOUT_SECONDS="${TLC_HA_TEST_TIMEOUT_SECONDS:-60}"
TLC_HA_START_DELAY_SECONDS="${TLC_HA_START_DELAY_SECONDS:-1}"
TLC_HA_VISIBILITY_OFFSET="${TLC_HA_VISIBILITY_OFFSET:-268435456}"
TLC_HA_VISIBILITY_FRAME_BYTES="${TLC_HA_VISIBILITY_FRAME_BYTES:-4096}"
TLC_HA_VISIBILITY_ITERATIONS="${TLC_HA_VISIBILITY_ITERATIONS:-10000}"
TLC_HA_VISIBILITY_TIMEOUT_SECONDS="${TLC_HA_VISIBILITY_TIMEOUT_SECONDS:-30}"
TLC_HA_VISIBILITY_START_DELAY_SECONDS="${TLC_HA_VISIBILITY_START_DELAY_SECONDS:-1}"
TLC_HA_EXPECTED_EVENTS="${TLC_HA_EXPECTED_EVENTS:-10000}"
