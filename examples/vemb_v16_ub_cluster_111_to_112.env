# Fixed UB allocation. All paths below are actual /dev/obmm_shmdevN names.
# Local exports map to peer imports as: 1->5, 2->6, 3->7, 4->8 and
# 9->13, 10->14, 11->15, 12->16. All mappings preserve acquire/release.
# UB access mode is selected by the shared open+mmap helper; this file only
# assigns the provider and peer device paths.

# NODE0@111: local exports and local/remote views.
NODE0_META_LOCAL_PATH=/dev/obmm_shmdev3
NODE0_WARM_LOCAL_PATH=/dev/obmm_shmdev3
NODE0_WARM_PEER_PATH=/dev/obmm_shmdev16
NODE0_META_PEER_PATH=/dev/obmm_shmdev16
NODE0_AERON_REQUEST_PATH=/dev/obmm_shmdev1
NODE0_AERON_RESPONSE_PATH=/dev/obmm_shmdev2
NODE0_RPC_REQUEST_PATH=/dev/obmm_shmdev4
NODE0_RPC_RESPONSE_PATH=/dev/obmm_shmdev4
NODE0_RPC_INBOUND_REQUEST_PATH=/dev/obmm_shmdev13
NODE0_RPC_INBOUND_RESPONSE_PATH=/dev/obmm_shmdev13

# NODE1@112: local exports and local/remote views.
NODE1_META_LOCAL_PATH=/dev/obmm_shmdev12
NODE1_WARM_LOCAL_PATH=/dev/obmm_shmdev12
NODE1_WARM_PEER_PATH=/dev/obmm_shmdev7
NODE1_META_PEER_PATH=/dev/obmm_shmdev7
NODE1_AERON_REQUEST_PATH=/dev/obmm_shmdev10
NODE1_AERON_RESPONSE_PATH=/dev/obmm_shmdev15
NODE1_RPC_REQUEST_PATH=/dev/obmm_shmdev9
NODE1_RPC_RESPONSE_PATH=/dev/obmm_shmdev9
NODE1_RPC_INBOUND_REQUEST_PATH=/dev/obmm_shmdev8
NODE1_RPC_INBOUND_RESPONSE_PATH=/dev/obmm_shmdev8

# CLI@111 peer views for owner1@112.
CLI_NODE1_AERON_REQUEST_PATH=/dev/obmm_shmdev14
CLI_NODE1_AERON_RESPONSE_PATH=/dev/obmm_shmdev11
CLI_NODE1_WARM_PATH=/dev/obmm_shmdev16

REMOTE_META_MMAP_OFFSET=268435456
SERVER_RPC_REQUEST_OFFSET=134217728
SERVER_RPC_RESPONSE_OFFSET=201326592
