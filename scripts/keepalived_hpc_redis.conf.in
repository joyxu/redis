! Generated by scripts/deploy_keepalived_ha.sh. Do not edit on a node.

global_defs {
    router_id @ROUTER_ID@
}

vrrp_script chk_hpc_redis {
    script "@INSTALL_ROOT@/scripts/ha_healthcheck.sh"
    interval @CHECK_INTERVAL@
    # Keep the tracked script at weight 0 in keepalived 1.2.2: a failed
    # healthcheck must enter FAULT and release the VIP, not merely lower
    # priority while continuing to advertise as MASTER.
    weight 0
    fall @CHECK_FALL@
    rise @CHECK_RISE@
}

vrrp_instance HPC_REDIS_HA {
    state BACKUP
    interface @INTERFACE@
    virtual_router_id @VRID@
    nopreempt
    priority @PRIORITY@
    advert_int @ADVERT_INT@

    authentication {
        auth_type PASS
        auth_pass @AUTH_PASS@
    }

    virtual_ipaddress {
        @VIP@
    }

    track_script {
        chk_hpc_redis weight 0
    }

    notify_master "@INSTALL_ROOT@/scripts/ha_notify.sh MASTER"
    notify_backup "@INSTALL_ROOT@/scripts/ha_notify.sh BACKUP"
    notify_fault "@INSTALL_ROOT@/scripts/ha_notify.sh FAULT"
}
